# See the documentation for more information: https://pocket-id.org/docs/configuration/environment-variables

# These variables must be configured for your deployment:
APP_URL={{ pocket_id_app_url }}

DATA_LOCATION={{ pocket_id_data_dir }}
# Encryption key (choose one method):
# Method 1: Direct key (simple but less secure)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY={{ pocket_id_encryption_key }}
# Method 2: File-based key (recommended)
# Put the base64 key in a file and point to it here.
# ENCRYPTION_KEY_FILE=/path/to/encryption_key

# These variables are optional but recommended to review:
TRUST_PROXY={{ pocket_id_trust_proxy }}
MAXMIND_LICENSE_KEY=
PUID={{ pocket_id_puid }}
PGID={{ pocket_id_pgid }}

UI_CONFIG_DISABLED={{ pocket_id_ui_config_disabled }}

SMTP_HOST={{ pocket_id_smtp_host }}
SMTP_PORT={{ pocket_id_smtp_port }}
SMTP_FROM={{ pocket_id_smtp_from }}
SMTP_USER={{ pocket_id_smtp_user }}
SMTP_PASSWORD={{ pocket_id_smtp_password }}
SMTP_TLS={{ pocket_id_smtp_tls }}
EMAIL_LOGIN_NOTIFICATION_ENABLED={{ pocket_id_email_login_notification_enabled }}
EMAIL_ONE_TIME_ACCESS_AS_ADMIN_ENABLED={{ pocket_id_email_one_time_access_as_admin_enabled }}
EMAIL_ONE_TIME_ACCESS_AS_UNAUTHENTICATED_ENABLED={{ pocket_id_email_one_time_access_as_unauthenticated_enabled }}
EMAIL_API_KEY_EXPIRATION_ENABLED={{ pocket_id_email_api_key_expiration_enabled }}
EMAIL_VERIFICATION_ENABLED={{ pocket_id_email_verification_enabled }}
