# Directories
DATA_LOCATION: {{ paperless_dir }}/data
MEDIA_LOCATION: {{ paperless_media_dir }}
EXPORT_LOCATION: {{ paperless_dir }}/export
CONSUME_LOCATION: {{ paperless_dir }}/consume
# Redis Broker
PAPERLESS_REDIS: redis://broker:6379
PAPERLESS_DBHOST: {{ paperless_dbhost }}

#Postgres
POSTGRES_DB: {{ paperless_postgres_db }}
POSTGRES_USER: {{ paperless_postgres_user }}
POSTGRES_PASSWORD: {{ paperless_postgres_password }}

#Tika
PAPERLESS_TIKA_ENABLED: true
PAPERLESS_TIKA_ENDPOINT: http://tika:9998
PAPERLESS_TIKA_GOTENBERG_ENDPOINT: http://gotenberg:3000

# Hosting & Security
PAPERLESS_SECRET_KEY: {{ paperless_secret_key }}
PAPERLESS_URL: {{ paperless_url }}
PAPERLESS_ALLOWED_HOSTS: {{ paperless_allowed_hosts }}
PAPERLESS_TRUSTED_PROXIES: {{ paperless_trusted_proxies }}
PAPERLESS_LOGOUT_REDIRECT_URL: {{ paperless_logout_redirect_url | default("") }}

# Authentication & SSO
PAPERLESS_ACCOUNT_ALLOW_SIGNUPS: {{ paperless_account_allow_signups | default(false) }}
PAPERLESS_ACCOUNT_DEFAULT_GROUPS: {{ paperless_account_default_groups | default("") }}
PAPERLESS_SOCIALACCOUNT_PROVIDERS: {{ paperless_socialaccount_providers | to_json | default("{}") }}
PAPERLESS_SOCIAL_AUTO_SIGNUP: {{ paperless_social_auto_signup | default(true) }}
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS: {{ paperless_social_account_sync_groups | default(false) }}
PAPERLESS_DISABLE_REGULAR_LOGIN: {{ paperless_disable_regular_login | default(false) }}
PAPERLESS_REDIRECT_LOGIN_TO_SSO: {{ paperless_redirect_login_to_sso | default(false) }}
PAPERLESS_ACCOUNT_SESSION_REMEMBER: {{ paperless_account_session_remember | default(true) }}

# Software tweaks
PAPERLESS_TASK_WORKERS: {{ paperless_task_workers | default("1") }}
PAPERLESS_TIME_ZONE: {{ paperless_time_zone | default("UTC") }}
PAPERLESS_APPS: {{ paperless_apps | default("") }}
